# Internal lobby role, read by mygo-lobby.service after base.env.
# The lobby listens on loopback only and is reached through the edge.
LOBBY_HOST=127.0.0.1
LOBBY_PORT=8079
# Global ceiling across every rooms instance on this host.
MAX_ROOMS=4
# Per-instance ceiling used when the lobby places a new room. Defaults to
# MAX_ROOMS when unset; set it to the rooms MAX_ROOMS value per instance.
ROOMS_PER_INSTANCE=4
# An instance that misses heartbeats for this long leaves the directory.
INSTANCE_TTL_MS=6000
# How long a placed but not yet registered room reserves capacity.
RESERVATION_TTL_MS=10000
