# Internal rooms role, read by mygo-rooms@.service after base.env.
# Each instance runs its own JVM and GraalJS combat contexts. INSTANCE_ID is
# supplied by the template instance name (mygo-rooms@a → INSTANCE_ID=a), and
# INSTANCE_URL defaults to http://$ROOMS_HOST:$ROOMS_PORT.
ROOMS_HOST=127.0.0.1
ROOMS_PORT=8091
# Ceiling for this instance only; the lobby keeps the global MAX_ROOMS.
MAX_ROOMS=2
LOBBY_URL=http://127.0.0.1:8079
HEARTBEAT_INTERVAL_MS=2000

# Additional instances: add the instance ID to ROOMS_INSTANCES in base.env and
# create /etc/mygo-fighter/rooms-<id>.env for the values that must differ from
# this file. A second instance on the same host needs only:
#   ROOMS_PORT=8092
# INSTANCE_URL and INSTANCE_ID then follow automatically.
