# Public edge role, read by mygo-edge.service after base.env.
# The edge is the only process that listens on a public-facing address; Caddy
# forwards HTTPS and WSS to HOST:PORT.
HOST=127.0.0.1
PORT=8080
WEB_ROOT=/srv/mygo-fighter/current/web
# The lobby answers room placement and ownership lookups over loopback.
LOBBY_URL=http://127.0.0.1:8079
# ROOMS_DIRECT_URL is only a fallback for a one-process debugging layout with no
# lobby. Leave it unset when LOBBY_URL is configured.
# ROOMS_DIRECT_URL=http://127.0.0.1:8091
# Accept the last X-Forwarded-For address only from a loopback proxy (Caddy).
TRUST_LOCAL_PROXY=true

# Optional edge tunables (defaults shown).
# ROOM_CACHE_TTL_MS=3000
# OWNER_LOOKUP_TIMEOUT_MS=300
# FORWARD_TIMEOUT_MS=10000
# WS_QUEUE_FRAMES=64
