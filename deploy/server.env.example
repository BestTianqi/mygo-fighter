# Legacy single-unit environment file for the retired mygo-fighter.service.
#
# New installations use /etc/mygo-fighter/base.env plus edge.env, lobby.env and
# rooms.env. The mygo-fighter unit is no longer installed or enabled, and the
# edge/lobby/rooms units do not read /etc/mygo-fighter.env.
#
# This example is kept so an existing host can copy its old values during the
# migration instead of losing them silently. See docs/WAN.md and
# docs/SERVICES.md for the mapping:
#   HOST, PORT, WEB_ROOT, TRUST_LOCAL_PROXY  -> edge.env
#   MAX_ROOMS                                -> lobby.env (global) and rooms.env
#                                               (per instance)
HOST=127.0.0.1
PORT=8080
WEB_ROOT=/srv/mygo-fighter/current/web
MAX_ROOMS=2
TRUST_LOCAL_PROXY=true
